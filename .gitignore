# Ignore everything in the root
/*

# But do NOT ignore these files (in root)
!.gitignore
!README.md

# Do NOT ignore this folder
!Files/

# Optionally, still ignore everything inside .obsidian or system junk
.obsidian/
.DS_Store
Thumbs.db

# Optional: ignore pasted images only in root
/Pasted image*.png
/Pasted image*.jpg
/Pasted image*.jpeg

